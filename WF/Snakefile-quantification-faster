rule FeatureCounts_exonic_segments:
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome",
                        "{sample}.Aligned.sortedByCoord.uniquely_mapped.bam"),
        exonic_segments_gtf = config['exonic_segments_gtf'],
    params:
        outdir = os.path.join(config['output_dir'], "gene_expression_quantification", config["organism"],"FeatureCounts_exonic_segments"),
    output:
        out_gene_fragments_txt = os.path.join(config['output_dir'], "gene_expression_quantification", config["organism"],"FeatureCounts_exonic_segments","{sample}.exonic_segments.txt"),
    conda:
        "envs/FeatureCounts.yaml"
    threads:8
    resources:
        mem_mb=10000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"FeatureCounts_exonic_segments_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        featureCounts -p --countReadPairs -O --fraction -Q 255 -s 2 -B -C -P -d 1 -D 10000000000000 -T {threads} -t exon -g gene_id -a {input.exonic_segments_gtf} -o {output.out_gene_fragments_txt} {input.bam}) &> {log}"""

