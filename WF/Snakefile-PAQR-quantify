rule PAQ_infer_relative_usage_mean:
    """
    Infer used poly(A) sites based on the coverage profiles
    and determine relative usage of those.
    """
    input:
        BED_pas_per_chr = os.path.join(config["output_dir"],"PAQR",config["organism"],"tandem_PAS_catalogue_per_chromosome","{chr}.bed"),
        PKL_pas_coverage = lambda wildcards: expand(
            os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages","{sample}.{{chr}}.pkl"),
            sample = list(samples.index)
        ),
        TSV_extensions = lambda wildcards: expand(
            os.path.join(config["output_dir"],"PAQR",config["organism"],"extensions","{sample}.{{chr}}.extensions.tsv"),
            sample = list(samples.index)
        ),
        SCRIPT_ = os.path.join(workflow.basedir, "scripts", "paqr","infer-pas-expression-mean.py"),

    output:
        TSV_pas_relative_usages = os.path.join(
            config["output_dir"],
            "PAQR",
            config["organism"],"quantifications",
            "tandem_pas_relative_usage-mean.{chr}.tsv"),
        TSV_pas_epxression_values = os.path.join(
            config["output_dir"],
            "PAQR",
            config["organism"],"quantifications",
            "tandem_pas_expression-mean.{chr}.tsv"
        ),
        TSV_distal_sites = os.path.join(
            config["output_dir"],
            "PAQR",
            config["organism"],"quantifications",
            "singular_pas_expression-mean.{chr}.tsv"
        ),

    params:
        input_per_sample_dir_coverages = os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages"),
        input_per_sample_dir_extensions = os.path.join(config["output_dir"],"PAQR",config["organism"],"extensions"),
        outdir = os.path.join(config["output_dir"],"PAQR",config["organism"],"quantifications"),
        LIST_sample_conditions = samples["paqr_condition"].tolist(),
        LIST_sample_names = expand("{sample}.{{chr}}",sample = list(samples.index)),
        INT_read_length = config['PAQ_fragment_length'],
        INT_min_length_mean_coverage = config['PAQ_min_length_mean_coverage'],
        FLOAT_min_mean_exon_coverage = config['PAQ_min_mean_exon_coverage'],
        INT_distal_downstream_extension = config['PAQ_distal_downstream_extension'],
        FLOAT_max_mean_coverage = config['PAQ_max_mean_coverage'],
        FLOAT_cluster_distance = config['PAQ_cluster_distance'],
        INT_upstream_cluster_extension = config['PAQ_upstream_cluster_extension'],
        FLOAT_coverage_mse_ratio_limit = config['PAQ_coverage_mse_ratio_limit'],

    threads: 20
    resources:
        mem_mb=70000,
        runtime=1400,
    log:
        os.path.join(config["local_log"],"PAQ_infer_relative_usage_mean_{chr}.log")
    conda:
        os.path.join(workflow.basedir, "envs", "PAQR.yaml")

    shell:
        """mkdir -p {params.outdir}; \
        python {input.SCRIPT_} \
        --expressions_out {output.TSV_pas_epxression_values} \
        --clusters {input.BED_pas_per_chr} \
        --coverages_dir {params.input_per_sample_dir_coverages} \
        --conditions {params.LIST_sample_conditions} \
        --names {params.LIST_sample_names} \
        --ex_extension_dir {params.input_per_sample_dir_extensions} \
        --read_length {params.INT_read_length} \
        --min_coverage_region {params.INT_min_length_mean_coverage} \
        --min_mean_coverage {params.FLOAT_min_mean_exon_coverage} \
        --ds_reg_for_no_coverage {params.INT_distal_downstream_extension} \
        --min_cluster_distance {params.FLOAT_cluster_distance} \
        --mse_ratio_threshold {params.FLOAT_coverage_mse_ratio_limit} \
        --best_break_point_upstream_extension {params.INT_upstream_cluster_extension} \
        --max_downstream_coverage {params.FLOAT_max_mean_coverage} \
        --distal_sites {output.TSV_distal_sites} \
        --processors {threads} 1> {output.TSV_pas_relative_usages} 2> {log}"""