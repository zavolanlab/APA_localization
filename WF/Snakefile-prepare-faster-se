rule get_fastq_files:
    """
        Download data from ENCODE, SRA, or make a symbolic link if the data is present on the cluster
    """
    output:
        fastq_1=(os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R1.fastq.gz")),

    params:
        path_1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
        data_source = lambda wildcards: samples.loc[wildcards.sample, "source"],
        outdir = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq")
    threads: 1
    log:
        os.path.join(config["local_log"],"download_fastq_files_from_ENCODE_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        if [[ {params.data_source} == "ENCODE" ]]; then \
        wget -O {output.fastq_1} {params.path_1}; \
        elif [[ {params.data_source} == "CLUSTER" ]]; then \
        rm -f {output.fastq_1} && ln -f -s {params.path_1} {output.fastq_1}; fi) \
        &> {log}"""


rule fastqc_input_files:
    """
        A quality control tool for high throughput sequence data
    """
    input:
        reads=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.{read_pair}.fastq.gz"),
    output:
        outdir=directory(os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastqc",
            "0.input.{read_pair}")),
    threads: 4
    resources:
        mem_mb=10000,
        runtime=60,
    singularity:
        "docker://staphb/fastqc:0.12.1"
    log:
        os.path.join(config["local_log"],"fastqc_input_files__{sample}_{read_pair}.log"),
    shell:
        """(set +o pipefail; mkdir -p {output.outdir}; \
        fastqc --outdir {output.outdir} \
        --threads {threads} \
        {input.reads}) \
        &> {log}"""

rule remove_polya:
    """
        Remove remaining poly(A) stretches from 3' end of R1 reads and poly(T) from 5'end of R2 reads if present
    """
    input:
        reads=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.{read_pair}.fastq.gz"),
    output:
        no_polya_fastq = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.{read_pair}.2.no_polyA.fastq.gz"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq"),
    conda:
        "envs/cutadapt.yaml"
    threads: 10
    resources:
        mem_mb=50000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"remove_polya__{sample}_{read_pair}.log")
    shell:
        """(mkdir -p {params.outdir}; \
        cutadapt -m 25 -j {threads} -a "A{{8}}N{{200}}" -a "T{{8}}N{{200}}" -o {output.no_polya_fastq} {input.reads};) \
        &> {log}"""

