# make coverage - needed to quantify the abundance of mutations in RNA sequencing

rule make_genomic_coverage:
    """
        coverage WITH specified nucleotides, in order to groupby them - across whole genome or across genes
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
        genome = config["genome_file"],
        exons_bed = config['exonic_segments_bed'],
    output:
        coverage_tsv_gz = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.uniquely_mapped.coverage.tsv.gz"),
        genome_wide_ref_nt_abundance_tsv = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.uniquely_mapped.genome_wide_ref_nt_abundance.tsv"),
        gene_level_ref_nt_abundance_tsv = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.uniquely_mapped.gene_level_ref_nt_abundance.tsv"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "map_genome_merged"),
        coverage_tsv = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.uniquely_mapped.coverage.tsv"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 6
    resources:
        mem_mb=60000,
        runtime=1000,
    log:
        os.path.join(config["local_log"],"make_genomic_coverage_{merged_sample}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        samtools view -@ {threads} -F 0x10 -u {input.bam} | \
        samtools depth -s - | \
        awk '{{print $1 "\t" ($2 - 1) "\t" $2 "\t" "t" "\t" $3 "\t" "+"}}' | \
        bedtools getfasta -s -bedOut -fi {input.genome} -bed - | \
        awk '{{print $1 "\t" $3 "\t" $6 "\t" $7 "\t" $5}}' > {params.coverage_tsv} && \
        samtools view -@ {threads} -f 0x10 -u {input.bam} | \
        samtools depth -s - | \
        awk '{{print $1 "\t" ($2 - 1) "\t" $2 "\t" "t" "\t" $3 "\t" "-"}}' | \
        bedtools getfasta -s -bedOut -fi {input.genome} -bed - | \
        awk '{{print $1 "\t" $3 "\t" $6 "\t" $7 "\t" $5}}' >> {params.coverage_tsv} && \
        pigz -p {threads} -f -c {params.coverage_tsv} > {output.coverage_tsv_gz}; \
        zcat {output.coverage_tsv_gz} | cut -f4,5 | \
        awk -F'\t' '{{ sums[$1] += $2 }} END {{ for (group in sums) {{ print group "\t" sums[group] }} }}' | \
        sort -k1,1 > {output.genome_wide_ref_nt_abundance_tsv}; \
        zcat {output.coverage_tsv_gz} | awk '{{print $1 "\t" ($2 - 1) "\t" $2 "\t" $4 "\t" $5 "\t" $3}}' | \
        sort -k1,1 -k2,2n | bedtools intersect -s -wb -sorted -a - -b {input.exons_bed} | \
        awk '{{print $10 "\t" $4 "\t" $5}}' | \
        awk -F'\t' '{{ key = $1 FS $2; sums[key] += $3 }} END {{ for (k in sums) {{  print k "\t" sums[k] }} }}' | \
        sort -k1,1 -k2,2 > {output.gene_level_ref_nt_abundance_tsv}; \
        rm -f {params.coverage_tsv}; \
        ) \
        &> {log}"""

