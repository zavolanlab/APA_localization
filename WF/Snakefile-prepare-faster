rule get_fastq_files:
    """
        Download data from ENCODE, SRA, or make a symbolic link if the data is present on the cluster
    """
    output:
        fastq_1=(os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R1.fastq.gz")),
        fastq_2=(os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R2.fastq.gz")),
    params:
        path_1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
        path_2=lambda wildcards: samples.loc[wildcards.sample, "fq2"],
        data_source = lambda wildcards: samples.loc[wildcards.sample, "source"],
        outdir = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq")
    threads: 1
    log:
        os.path.join(config["local_log"],"download_fastq_files_from_ENCODE_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        if [[ {params.data_source} == "ENCODE" ]]; then \
        wget -O {output.fastq_1} {params.path_1} && \
        wget -O {output.fastq_2} {params.path_2}; \
        elif [[ {params.data_source} == "CLUSTER" ]]; then \
        rm -f {output.fastq_1} && ln -f -s {params.path_1} {output.fastq_1} && \
        rm -f {output.fastq_2} && ln -f -s {params.path_2} {output.fastq_2}; fi) \
        &> {log}"""

rule sanitize_fastq_files:
    """
        use seqkit sana
    """
    input:
        fastq_1=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R1.fastq.gz"),
        fastq_2=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R2.fastq.gz"),
    output:
        fastq_1=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized",
            "{sample}.R1.fastq.gz"),
        fastq_2=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized",
            "{sample}.R2.fastq.gz"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized"),
        tempdir = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized_temp"),
        fastq_1_intermediate=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized_temp",
            "{sample}.R1.fastq.gz"),
        fastq_2_intermediate=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq_sanitized_temp",
            "{sample}.R2.fastq.gz"),
    threads: 3
    resources:
        mem_mb=100000,
        runtime=500,
    conda:
        "envs/samtools_latest.yaml"
    log:
        os.path.join(config["local_log"],"sanitize_fastq_files_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir} {params.tempdir}; \
        seqkit sana {input.fastq_1} -o {params.fastq_1_intermediate} --quiet; \
        seqkit sana {input.fastq_2} -o {params.fastq_2_intermediate} --quiet; \
        seqkit pair --quiet -f -1 {params.fastq_1_intermediate} -2 {params.fastq_2_intermediate} -O {params.outdir} && \
        rm {params.fastq_1_intermediate} {params.fastq_2_intermediate} \
        ) &> {log}"""

