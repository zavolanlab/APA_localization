rule map_genome_star_se:
    """
        Map to genome using STAR
    """
    input:
        chromosome_info=os.path.join(config["output_dir"],"STAR_indices",config["organism"],"without_GTF","STAR_index","chrNameLength.txt"),
        fastq_1=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "fastq",
            "{sample}.R1.3.adapter3trim.fastq.gz"),
    output:
        bam=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.bam",
        ),
        log_final_file=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "{sample}.Log.final.out",
        ),
    params:
        outFileNamePrefix=lambda wildcards, output: output.bam.replace(
            "Aligned.sortedByCoord.out.bam", ""
        ),
        STAR_index=lambda wildcards, input: os.path.dirname(input.chromosome_info),
    conda:
        "envs/STAR.yaml"
    resources:
        mem_mb=70000,
        runtime=300,
    threads: 12
    log:
        os.path.join(config["local_log"],"map_genome_star_pe__{sample}.log")
    shell:
        """(STAR \
        --runMode alignReads \
        --alignEndsType Local \
        --runThreadN {threads} \
        --genomeDir {params.STAR_index} \
        --readFilesIn {input.fastq_1} \
        --readFilesCommand zcat \
        --outFileNamePrefix {params.outFileNamePrefix} \
        --genomeLoad NoSharedMemory \
        --outSAMtype BAM SortedByCoordinate \
        --outFilterType BySJout \
        --twopassMode None \
        --outBAMsortingThreadN {threads} \
        --outFilterMultimapNmax 500000000 \
        --outSAMattrIHstart 0 \
        --outSAMattributes All \
        --limitOutSJcollapsed 5000000) \
        &> {log}"""

