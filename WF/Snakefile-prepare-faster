### Rules for TIN score calculation

rule extract_transcripts_as_bed12:
    """
        Convert transcripts to BED12 format
        transcript_biotype, not transcript_type features are expected!!!
    """
    input:
        gtf=config["gtf_file"],
    output:
        bed12=os.path.join(
            config["output_dir"],
            "modified_annotations",
            config["organism"],
            "full_transcripts_protein_coding.bed"),
        temp_gtf = temp(os.path.join(
            config["output_dir"],
            "modified_annotations",
            config["organism"],
            "modified_gtf.gtf")),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "modified_annotations",
            config["organism"]),
        
    container:
        "docker://quay.io/biocontainers/zgtf:0.1.1--pyh5e36f6f_0"
    threads: 1
    log:
        os.path.join(config["local_log"],"extract_transcripts_as_bed12.log")
    shell:
        "(mkdir -p {params.outdir}; \
        cp {input.gtf} {output.temp_gtf}; \
        sed -i 's/transcript_type/transcript_biotype/' {output.temp_gtf}; \
        gtf2bed12 \
        --gtf {output.temp_gtf} \
        --bed12 {output.bed12}) \
        &> {log}"


rule calculate_TIN_scores:
    """
        Calculate transcript integrity (TIN) score
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome_merged",
                        "{sample}.Aligned.sortedByCoord.out.merged.bam"),
        transcripts_bed12=os.path.join(
            config["output_dir"],
            "modified_annotations",
            config["organism"],
            "full_transcripts_protein_coding.bed"),
    output:
        TIN_score=os.path.join(
                config["output_dir"], "samples", "{sample}", "TIN", "TIN_score.tsv"
            ),
    params:
        sample = "{sample}",
        outdir = os.path.join(config["output_dir"], "samples", "{sample}", "TIN"),
    container:
        "docker://quay.io/biocontainers/tin-score-calculation:0.6.3--pyh5e36f6f_0"
    threads: 4
    log:
        os.path.join(config["local_log"],"calculate_TIN_scores_{sample}.log")
    shell:
        "(mkdir -p {params.outdir}; calculate-tin.py \
        -i {input.bam} \
        -r {input.transcripts_bed12} \
        --names {params.sample} \
        -p {threads} \
        > {output.TIN_score}) &> {log}"
        
