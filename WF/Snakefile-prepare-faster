            config["output_dir"],
            "rnaseqmut")),
    threads: 4
    resources:
        mem_mb=10000,
        runtime=359,
        qos='6hours'
    singularity:
        "docker://davidliwei/rnaseqmut"
    log:
        os.path.join(config["local_log"],"rnaseqmut__{merged_sample}.log")
    shell:
